{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoLink Desktop",
  "version": "0.1.0",
  "identifier": "dev.colink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoLink Desktop",
        "width": 1240,
        "height": 840,
        "minWidth": 980,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
