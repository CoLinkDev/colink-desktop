{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoLink Desktop",
  "version": "0.1.0",
  "identifier": "dev.colink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoLink Desktop",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": "v1Compatible",
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "languages": [
          "SimpChinese",
          "English",
          "TradChinese",
          "Japanese",
          "Korean",
          "Spanish",
          "German",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2Mzc3Qjc5OTIyRTVCNApSV1MwNVNLWnQzZGpBYm93T3JjR3VNVDdDNWVPWkwvNVA2MTJkZk01WnVpZjU5Ti9nd2hKS1p0bgo="
    }
  }
}
