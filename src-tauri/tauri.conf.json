{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoLink Desktop",
  "version": "0.1.0",
  "identifier": "dev.colink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoLink Desktop",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/notes-attachments/**",
          "$DATA/dev.colink.desktop.debug/notes-attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "languages": [
          "SimpChinese",
          "English",
          "TradChinese",
          "Japanese",
          "Korean",
          "Spanish",
          "German",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
